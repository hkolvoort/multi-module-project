{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": [
        "maven"
      ],
      "groupName": "All Maven Dependencies",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ],
  "branchPrefix": "feature/",
  "additionalBranchPrefix": "LCM-all-minor-dependencies",
  "automerge": false
}